{
  "manifest_version": 3,
  "name": "CyberShield — AI Phishing Detector",
  "version": "2.2",
  "description": "Real-time AI-powered phishing detection and blocking with explainable threat analysis.",

  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberShield — AI Phishing Detector",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.css", "warning.js", "icons/*.png"],
      "matches":   ["<all_urls>"]
    }
  ]
}
